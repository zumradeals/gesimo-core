# Avelis Séjours — seules valeurs posées une fois chez l'hébergeur.
# Tous les autres réglages (paiement, e-mail, SMS, commission, textes...) se saisissent
# dans l'espace Paramètres, et sont chiffrés en base.

# Environnement : "local" en développement, "production" chez l'hébergeur.
APP_ENV=production
APP_DEBUG=false

# Clé de chiffrement maître. Générer avec : php artisan key:generate
# La perdre = perdre tous les secrets enregistrés. La sauvegarder à part, hors du dépôt.
APP_KEY=

# Adresse de connexion à la base PostgreSQL.
# Forme : pgsql://utilisateur:motdepasse@serveur:5432/nom_de_la_base
DB_URL=
